<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="20" xmlns="http://javafx.com/javafx/8"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.cv_builder.HelloController"
      style="-fx-background-color: #f5f5f5;"
      prefWidth="600" prefHeight="400">

    <Label text="Welcome to CV Builder"
           style="-fx-font-size: 28px; -fx-font-weight: bold;" />

    <Button text="Create New CV"
            style="-fx-font-size: 18px; -fx-padding: 10 20; -fx-cursor: hand;"

            onAction="#handleNavigateToCreateCV" />

</VBox>
