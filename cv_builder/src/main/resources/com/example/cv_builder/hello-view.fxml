<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>

<StackPane styleClass="hello-root" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cv_builder.HelloController">
    <VBox styleClass="welcome-card">
        <Label styleClass="welcome-title" text="Welcome to CV Builder" />
        <HBox spacing="20" alignment="CENTER">
            <Button onAction="#handleNavigateToCreateCV" styleClass="primary-button" text="Create New CV" />
            <Button onAction="#handleNavigateToViewAllCVs" styleClass="secondary-button" text="View All CV" />
        </HBox>
    </VBox>
</StackPane>
