<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.ImageView?>

<ScrollPane fitToHeight="false" fitToWidth="true" hbarPolicy="AS_NEEDED" styleClass="preview-scroll-pane" stylesheets="@styles.css" vbarPolicy="AS_NEEDED" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cv_builder.PreviewController">

    <content>

        <StackPane alignment="CENTER" styleClass="preview-wrapper">

            <HBox spacing="0" styleClass="cv-root">

                <VBox maxWidth="-Infinity" minWidth="-Infinity" styleClass="sidebar" VBox.vgrow="ALWAYS">
                    <VBox alignment="CENTER" spacing="15">
                         <ImageView fx:id="profileImage" fitWidth="150" fitHeight="150" preserveRatio="true" styleClass="profile-image" />
                    </VBox>

                    <VBox spacing="10" styleClass="sidebar-block">
                        <Label styleClass="sidebar-heading" text="SKILLS" />
                        <!-- Separator removed as requested -->
                        <Label fx:id="skills" styleClass="sidebar-text" wrapText="true" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />
                </VBox>


                <Region prefWidth="8" styleClass="vertical-divider" />


                <VBox minWidth="350.0" spacing="32" styleClass="content-area" HBox.hgrow="ALWAYS">
                    <VBox.margin>
                        <Insets bottom="40" left="60" right="60" top="40" />
                    </VBox.margin>


                    <VBox spacing="18">
                        <Label fx:id="name" styleClass="name-heading" text="Ahmed Safi" />

                        <VBox styleClass="contact-info">
                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="contact-row">
                                <Label styleClass="contact-icon" text="☎" />
                                <Label fx:id="phone" styleClass="contact-text" text="+8801867271008" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="contact-row">
                                <Label styleClass="contact-icon" text="✉" />
                                <Label fx:id="email" styleClass="contact-text" text="ssa222158@gmail.com" />
                            </HBox>
                            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="contact-row">
                                <Label styleClass="contact-icon" text="⌖" />
                                <Label fx:id="address" styleClass="contact-text" text="Khulna, Bangladesh" />
                            </HBox>
                        </VBox>

                        <Separator styleClass="header-separator" />
                    </VBox>


                    <VBox spacing="10" styleClass="section">
                        <Label styleClass="section-heading" text="EXPERIENCE" />
                        <Label fx:id="experiences" styleClass="section-body" wrapText="true" />
                    </VBox>


                    <VBox spacing="10" styleClass="section">
                        <Label styleClass="section-heading" text="EDUCATION" />
                        <Label fx:id="education" styleClass="section-body" wrapText="true" />
                    </VBox>

                    <VBox spacing="10" styleClass="section">
                        <Label styleClass="section-heading" text="PROJECTS" />
                        <Label fx:id="projects" styleClass="section-body" wrapText="true" />
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox alignment="BOTTOM_RIGHT">
                        <Button onAction="#handleBack" styleClass="back-button" text="← Back to Form" />
                    </HBox>

                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                </VBox>

            </HBox>
            
        </StackPane>
    </content>
</ScrollPane>