<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox spacing="20" styleClass="form-container" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.cv_builder.CVListController">
    
    <StackPane>
        <HBox alignment="CENTER_LEFT" pickOnBounds="false">
            <Button onAction="#handleBack" styleClass="secondary-button" text="← Back" />
        </HBox>
        <Label styleClass="section-title" text="All CVs" mouseTransparent="true" />
    </StackPane>

    <TableView fx:id="cvTable" VBox.vgrow="ALWAYS" styleClass="cv-table">
        <columns>
            <TableColumn fx:id="idColumn" text="ID" prefWidth="50" />
            <TableColumn fx:id="imageColumn" text="" prefWidth="80" />
            <TableColumn fx:id="nameColumn" text="Full Name" prefWidth="250" />
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="250" />
            <TableColumn fx:id="actionColumn" text="" prefWidth="100" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
